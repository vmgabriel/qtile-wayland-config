# -*- coding: utf-8 -*-
"""
Configuración principal de Qtile - Versión Wayland Segura
Autor: vmgabriel
"""

import os
import subprocess
import json
import re
from typing import List

from libqtile import bar, layout, widget, hook, qtile
from libqtile.config import Click, Drag, Group, Key, KeyChord, Match, Screen, ScratchPad, DropDown
from libqtile.lazy import lazy
from libqtile.utils import guess_terminal

# =============================================================================
# 🔧 CONSTANTES Y CONFIGURACIÓN BÁSICA
# =============================================================================

mod = "mod4"
# Recomendación: usa 'foot' o 'kitty' en Wayland. Si prefieres urxvt, usa 'urxvt' (sin la c)
terminal = "alacritty"
city_weather_code = "3688689"

# =============================================================================
# 🎨 COLORES (con fallback seguro)
# =============================================================================

default_colors = {
    "color0": "#282828", "color1": "#cc241d", "color2": "#98971a",
    "color3": "#d79921", "color4": "#458588", "color5": "#b16286",
    "color6": "#689d6a", "color7": "#a89984", "color8": "#928374",
    "color9": "#fb4934",
}

try:
    colors_path = os.path.expanduser("~/.cache/wal/colors.json")
    with open(colors_path) as f:
        colordict = json.load(f)
    ColorZ, ColorA, ColorB, ColorC, ColorD = [colordict["colors"][f"color{i}"] for i in range(5)]
    ColorE, ColorF, ColorG, ColorH, ColorI = [colordict["colors"][f"color{i}"] for i in range(5, 10)]
except (FileNotFoundError, KeyError, json.JSONDecodeError):
    ColorZ, ColorA, ColorB, ColorC, ColorD = [default_colors[f"color{i}"] for i in range(5)]
    ColorE, ColorF, ColorG, ColorH, ColorI = [default_colors[f"color{i}"] for i in range(5, 10)]

# =============================================================================
# 🚀 FUNCIONES AUXILIARES
# =============================================================================

def run(cmd: str):
    """Ejecuta un comando en segundo plano de forma segura en Wayland."""
    return lazy.spawn(cmd)

# Atajos personalizados (urxvtc cambiado a terminal nativa para evitar fallos)
htop = run(f"{terminal} -e htop")
powermenu = run("powermenu")
weather = run(f"xdg-open https://openweathermap.org/city/{city_weather_code}")
sound = run("outputmenu")
calendar = run(f"{terminal} -e khal interactive")
launcher = run("rofi -show drun -show-icons") # Simplificado para mayor compatibilidad Wayland
timer = run("timermenu")
metamenu = run("metamenu")

# =============================================================================
# ⚙️ HOOKS DE INICIO
# =============================================================================

@hook.subscribe.startup_once
def autostart():
    home = os.path.expanduser("~/.config/qtile/autostart.sh")
    if os.path.isfile(home):
        subprocess.call([home])

@hook.subscribe.startup
def autorestart():
    home = os.path.expanduser("~/.config/qtile/autorestart.sh")
    if os.path.isfile(home):
        subprocess.call([home])

# =============================================================================
# ⌨️ ATAJOS DE TECLADO
# =============================================================================

keys = [
    # --- Navegación ---
    Key([mod], "j", lazy.layout.down(), desc="Mover foco abajo"),
    Key([mod], "k", lazy.layout.up(), desc="Mover foco arriba"),
    Key([mod], "h", lazy.layout.left(), desc="Mover foco izquierda"),
    Key([mod], "l", lazy.layout.right(), desc="Mover foco derecha"),

    # --- Movimiento de ventanas ---
    Key([mod, "shift"], "j", lazy.layout.shuffle_down(), desc="Mover ventana abajo"),
    Key([mod, "shift"], "k", lazy.layout.shuffle_up(), desc="Mover ventana arriba"),
    Key([mod, "shift"], "h", lazy.layout.shuffle_left(), desc="Mover ventana izquierda"),
    Key([mod, "shift"], "l", lazy.layout.shuffle_right(), desc="Mover ventana derecha"),
    Key([mod, "mod1"], "n", lazy.layout.normalize(), desc="Normalizar tamaños"),

    # --- Redimensionar ---
    Key([mod, "control"], "h", lazy.layout.grow_left(), desc="Expandir izquierda"),
    Key([mod, "control"], "l", lazy.layout.grow_right(), desc="Expandir derecha"),
    Key([mod, "control"], "j", lazy.layout.grow_down(), desc="Expandir abajo"),
    Key([mod, "control"], "k", lazy.layout.grow_up(), desc="Expandir arriba"),

    # --- Layouts ---
    Key([mod], "space", lazy.layout.next(), desc="Siguiente ventana"),
    Key([mod], "Right", lazy.next_layout(), desc="Siguiente layout"),
    Key([mod], "Left", lazy.prev_layout(), desc="Layout anterior"),

    # --- Ventanas ---
    Key([], "F11", lazy.window.toggle_fullscreen(), desc="Pantalla completa"),
    Key([], "F10", lazy.window.toggle_floating(), desc="Modo flotante"),
    Key([mod], "x", lazy.window.kill(), desc="Cerrar ventana"),

    # --- Sistema ---
    Key([mod], "d", lazy.spawn("dmen"), desc="Cargas Menu Rapido"),
    Key([mod], "Return", lazy.spawn(terminal), desc="Abrir terminal"),
    Key([mod], "quoteleft", lazy.group["scratchpad"].dropdown_toggle("term"), desc="Terminal desplegable"),

    # --- Menús ---
    KeyChord([mod], "q", [
        Key([], "r", lazy.restart(), desc="Reiniciar Qtile"),
        Key([], "q", lazy.shutdown(), desc="Cerrar sesión"),
        Key([], "c", lazy.spawn("clipmenu"), desc="Portapapeles"),
    ]),
    KeyChord([mod], "a", [
        Key([], "w", lazy.spawn("zen-browser"), desc="Zen Browser"),
        Key([], "p", lazy.spawn("bitwarden-desktop"), desc="Bitwarden"),
        Key([], "c", lazy.spawn("gcolor3"), desc="Selector de color"),
    ]),
    KeyChord([mod], "c", [
        Key([], "space", launcher, desc="Lanzador"), # ✅ Corregido: sin paréntesis
        Key([], "h", lazy.spawn("hotkey"), desc="Guía de atajos"),
        Key([], "s", lazy.spawn("scrotmenu"), desc="Capturas"),
        Key([], "c", lazy.spawn("calendarmenu"), desc="Calendario"),
        Key([], "t", lazy.spawn("timermenu"), desc="Temporizador"),
    ]),

    # --- Multimedia ---
    Key([mod], "minus", lazy.spawn("amixer -q sset Master 3%-"), desc="Bajar volumen"),
    Key([mod], "plus", lazy.spawn("amixer -q sset Master 3%+"), desc="Subir volumen"),
    Key([mod], "0", lazy.spawn("amixer -q sset Master toggle"), desc="Silenciar"),
    Key([mod], "comma", lazy.spawn("playerctl previous"), desc="Anterior"),
    Key([mod], "period", lazy.spawn("playerctl next"), desc="Siguiente"),
    Key([mod], "apostrophe", lazy.spawn("playerctl play-pause"), desc="Play/Pausa"),

    # --- Aplicaciones ---
    Key([mod], "e", lazy.spawn("emacsclient -c"), desc="Emacs"),
    Key([mod], "r", lazy.spawn("liferea"), desc="Liferea"),
    Key([mod], "t", lazy.spawn(terminal), desc="Terminal"),
    Key([mod], "m", lazy.spawn("thunderbird"), desc="Thunderbird"),
    Key([mod], "v", lazy.spawn("vlc"), desc="VLC"),
    Key([mod], "f", lazy.spawn("nautilus"), desc="Archivos"),
    Key([mod], "o", lazy.spawn("pavucontrol"), desc="Audio avanzado"),
]

# --- Grupos (workspaces) ---
groups = [
    ScratchPad("scratchpad", [DropDown("term", terminal, opacity=0.95)]),
    Group("I", layout="monadtall", matches=[Match(wm_class=re.compile(r"^(qutebrowser|Thunderbird|liferea)$"))]),
    Group("II", layout="monadtall", matches=[Match(wm_class=re.compile(r"^(vlc|gpodder)$"))]),
    Group("III", layout="bsp", matches=[Match(wm_class=re.compile(r"^(Steam|Lutris|RetroArch|dosbox)$"))]),
    Group("IV", layout="max", matches=[Match(wm_class=re.compile(r"^(VirtualBox\ Machine|virt-manager|VirtualBox\ Manager|VirtualBoxVM)$"))]),
    Group("V", layout="max", matches=[Match(wm_class=re.compile(r"^(gimp|Inkscape|krita|darktable|shotwell|scribus|Blender)$"))]),
]

for i, group in enumerate(groups[1:], 1):
    keys.extend([
        Key([mod], str(i), lazy.group[group.name].toscreen(), desc=f"Ir a {group.name}"),
        Key([mod, "shift"], str(i), lazy.window.togroup(group.name), desc=f"Mover a {group.name}"),
    ])

# =============================================================================
# 🖼️ LAYOUTS Y PANTALLAS
# =============================================================================

layouts = [
    layout.MonadTall(margin=5, border_focus=ColorE, border_normal=ColorA),
    layout.Bsp(margin=5, border_focus=ColorE, border_normal=ColorA),
    layout.Max(),
]

widget_defaults = dict(font="Noto Sans", fontsize=13, padding=5, foreground=ColorG)
extension_defaults = widget_defaults.copy()

screens = [
    Screen(
        top=bar.Bar(
            [
                widget.GroupBox(highlight_method="line", urgent_border=ColorF, active=ColorG, inactive=ColorB, this_current_screen_border=ColorC),
                widget.Spacer(),
                widget.Clock(format="%a %b %d", font="Noto Sans Bold", mouse_callbacks={"Button1": calendar}),
                widget.Clock(format="%I:%M %p", font="Noto Sans Bold", mouse_callbacks={"Button1": timer}),
                widget.Spacer(),
                widget.TextBox(text="", mouse_callbacks={"Button1": sound}),
                widget.Volume(),
                widget.TextBox(text="", mouse_callbacks={"Button1": powermenu}),
            ],
            size=22, background="#282828",
        ),
        bottom=bar.Bar(
            [
                widget.TextBox(text="", foreground=ColorB, mouse_callbacks={"Button1": launcher}),
                widget.WindowName(font="Noto Sans Bold"),
                widget.GenPollText(
                    func=lambda: subprocess.check_output(["bash", "-c", "cmus-remote -Q 2>/dev/null | grep 'status' | cut -d' ' -f2 || echo '⏹'"]).decode().strip(),
                    update_interval=1, foreground=ColorG,
                ),
                widget.CPU(mouse_callbacks={"Button1": htop}),
                widget.Memory(format="MEM{MemUsed:.0f}{mm}", mouse_callbacks={"Button1": htop}),
                
                # ✅ CAMBIO CLAVE PARA WAYLAND: StatusNotifier en lugar de Systray
                widget.StatusNotifier(),
                
                widget.CurrentLayout(),
                widget.TextBox(text="", mouse_callbacks={"Button1": metamenu}),
            ],
            size=22, background="#282828",
        ),
    )
]

# =============================================================================
# 🖱️ MOUSE Y COMPORTAMIENTO
# =============================================================================

mouse = [
    Drag([mod], "Button1", lazy.window.set_position_floating(), start=lazy.window.get_position()),
    Drag([mod], "Button3", lazy.window.set_size_floating(), start=lazy.window.get_size()),
    Click([mod], "Button2", lazy.window.bring_to_front()),
]

floating_layout = layout.Floating(
    border_focus=ColorE, border_normal=ColorA,
    float_rules=[
        *layout.Floating.default_float_rules,
        Match(wm_class="confirmreset"), Match(wm_class="makebranch"), Match(wm_class="maketag"),
        Match(wm_class="ssh-askpass"), Match(title="branchdialog"), Match(title="pinentry"),
        Match(title="khal"), Match(wm_class="confirm"), Match(wm_class="dialog"),
        Match(wm_class="download"), Match(wm_class="error"), Match(wm_class="file_progress"),
        Match(wm_class="notification"), Match(wm_class="splash"), Match(wm_class="toolbar"),
        Match(wm_class="gcolor3"), Match(wm_class="qalculate-gtk"), Match(wm_class="qt5ct"),
    ]
)

# Opciones generales
follow_mouse_focus = True
bring_front_click = False
cursor_warp = False
auto_fullscreen = True
focus_on_window_activation = "smart"
reconfigure_screens = True
auto_minimize = False
wmname = "LG3D"
keyboard_layout = "latam" # ✅ Configuración nativa de teclado para Wayland
